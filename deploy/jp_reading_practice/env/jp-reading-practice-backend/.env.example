# Copy to .env next to this file and fill in the two passwords. They have to
# match what create_users_and_db.sql was run with.
#
# Note: write the passwords WITHOUT surrounding quotes. Docker Compose strips
# those before the container sees the value, so a role created with them can
# never be logged into.

# postgres-core lives in its own stack and is reached by container name over
# the external postgres-core-net.
DB_URL=postgresql://postgres-core:5432/jp_reading_practice
DB_USER=jp_reading_practice_app
DB_PASSWORD=
DB_OWNER_USER=jp_reading_practice_owner
DB_OWNER_PASSWORD=

# Optional here — the Settings screen stores a key in the database and that
# takes precedence. Setting it here means a fresh deployment can generate
# texts without visiting the screen first; the UI then says the key comes
# from the environment and cannot be cleared from the browser.
OPENAI_API_KEY=

# Kanji Trainer's read-only MCP server, which this backend reads known
# vocabulary from (see that repo's CLAUDE.md, "MCP server"). 8086 is Kanji
# Trainer's own published port.
KANJI_TRAINER_MCP_URL=http://192.168.2.230:8086/mcp

# The Kanji Trainer deployment must list 192.168.2.230:8086 in its own
# MCP_ALLOWED_HOSTS (env/kanji-trainer-backend/.env in that stack), or every
# call above gets back an HTTP 421 -- its DNS-rebinding check matches the
# Host header of the incoming request (i.e. exactly the host:port this URL
# dials) against that allowlist, and the default rejects everything but
# localhost.

# The SPA is served same-origin behind this stack's nginx, so no browser
# origin ever needs allowing.
CORS_ORIGINS=
