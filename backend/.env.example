# Copy to backend/.env for local development.

# --- OpenAI -----------------------------------------------------------------
# Can also be set in the Settings screen, which stores it in the database and
# takes precedence over this value.
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
# Writes the reading practice texts.
GENERATION_MODEL=gpt-4o-mini
# Answers reading-help questions about a text already on screen.
HELP_MODEL=gpt-4o

# --- Kanji Trainer MCP -------------------------------------------------------
# The Kanji Trainer's read-only MCP server (its own app/mcp_server.py),
# mounted at /mcp -- app/kanji_trainer.py is the client. Also settable in the
# Settings screen, which takes precedence over this value; a 421 back from
# it means this host needs adding to the Kanji Trainer's own
# MCP_ALLOWED_HOSTS.
KANJI_TRAINER_MCP_URL=http://localhost:8086/mcp

# --- Features -----------------------------------------------------------------
WEB_SEARCH_ENABLED=false

# --- Database -----------------------------------------------------------------
# Postgres only. DB_URL carries only host/port/database; credentials come per
# role. Both roles and the database must already exist -- see
# dev/initdb/01-roles.sql for local development.
DB_URL=postgresql://localhost:5432/jp_reading_practice
DB_USER=jp_reading_practice_app
DB_PASSWORD=
DB_OWNER_USER=jp_reading_practice_owner
DB_OWNER_PASSWORD=

# --- Server -------------------------------------------------------------------
# Only needed for `ng serve`, which runs on a different origin.
CORS_ORIGINS=http://localhost:4200
