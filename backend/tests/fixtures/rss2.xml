<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0">
  <channel>
    <title>Fixture News (RSS 2.0)</title>
    <link>https://example.test/news/</link>
    <description>A fixture mirroring NHK's own RSS 2.0 shape.</description>
    <lastBuildDate>{channel_date}</lastBuildDate>
    <item>
      <title>台風が近づいています</title>
      <link>https://example.test/news/typhoon</link>
      <description>台風が日本に近づいているという記事です。</description>
      <pubDate>{fresh_item_date}</pubDate>
    </item>
    <item>
      <title>日付のない記事</title>
      <link>https://example.test/news/no-date</link>
      <description>この記事には日付がありません。</description>
    </item>
    <item>
      <title>古い記事</title>
      <link>https://example.test/news/old</link>
      <description>これは古い記事です。</description>
      <pubDate>{stale_item_date}</pubDate>
    </item>
  </channel>
</rss>
